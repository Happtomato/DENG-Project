POSTGRES_DB=deng
POSTGRES_USER=deng
POSTGRES_PASSWORD=replace-with-local-password
# Prefect schedule, Europe/Zurich. The pipeline service must remain running.
PIPELINE_CRON=0 3 * * *
PIPELINE_SCHEDULE_ENABLED=false
# Conservative defaults; increase only after the allowed collection volume is clarified.
PIPELINE_MAX_PRODUCTS=3
PIPELINE_MAX_REQUESTS=20
PIPELINE_DELAY_SECONDS=3
