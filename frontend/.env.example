# Copy the existing repository-root .env to frontend/.env.local and set POSTGRES_HOST=127.0.0.1.
# Or configure the PostgreSQL connection here directly:
DATABASE_URL=postgresql://deng:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/deng
PREFECT_API_URL=http://127.0.0.1:4200/api
# Optional if starting outside frontend/:
# CATALOG_PATH=/absolute/path/to/DENG-Project/data/catalog/mediamarkt.json
